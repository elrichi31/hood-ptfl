# Safety net on top of backend/.gitignore and frontend/.gitignore

# Dependencies / builds
node_modules/
.next/
build/
out/
*.tsbuildinfo

# Secrets
.env
.env.*
!.env.example

# Robinhood OAuth tokens, probe dumps, auth + app databases
storage/
*.db
*.sqlite
*.sqlite3
backend/tmp/*
!backend/tmp/.gitkeep

# Logs / OS / editors
*.log
.DS_Store
.vscode/
.idea/
