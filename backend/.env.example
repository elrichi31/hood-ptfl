# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# News providers (News Intelligence page — leave blank to keep using mock data)
#--------------------------------------------------------------------
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
MARKETAUX_API_KEY=

# https://typesafe.ai — classifies news + portfolio impact (blank = heuristics)
TYPESAFE_API_KEY=

# Shared secret with the Next.js server (must match frontend BACKEND_TOKEN)
BACKEND_TOKEN=

# Prod only: base64 of storage/robinhood.json, seeds an empty volume on first boot
ROBINHOOD_AUTH=
